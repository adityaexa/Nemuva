# ============================================================================
# NEMUVA — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to .env.local for local development, and configure the same
# values in your hosting provider's environment variable settings for
# production (Vercel, Netlify, Hostinger, etc.).
#
# Nothing in this codebase hardcodes a real ID/secret — everything below is
# read from process.env, and every integration is disabled/hidden until its
# variable is set. See src/config/siteConfig.ts for how these are consumed.
# ============================================================================

# The canonical production URL of your site (no trailing slash).
# Used for canonical tags, Open Graph/Twitter images, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.nemuva.com

# ---- Analytics (optional) --------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to
# disable GA4 entirely — no script is loaded until this is set.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GTM_ID=

# ---- Payments (not yet wired up — see src/lib/payment.ts) -----------------
# Public Razorpay key, used by the client-side checkout widget once a real
# integration is implemented. NEVER put your Razorpay *secret* key here —
# secrets belong in server-only environment variables (no NEXT_PUBLIC_ prefix)
# and should only be read inside API routes / server components.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=   (server-only — do not prefix with NEXT_PUBLIC_)

# ---- Email / CRM (optional, for the API routes under src/app/api/) --------
# Add keys here for whichever provider you wire up in:
#   src/app/api/contact/route.ts
#   src/app/api/bulk-inquiry/route.ts
#   src/app/api/private-label/route.ts
#   src/app/api/newsletter/route.ts
# e.g.
# RESEND_API_KEY=
# MAILCHIMP_API_KEY=
